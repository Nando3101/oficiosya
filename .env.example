# ============================================================
# OFICIOSYA - Variables de entorno
# Copia este archivo como .env y completa los valores
# ============================================================

NODE_ENV=production
PORT=3000

# ── JWT ─────────────────────────────────────────────────────
# IMPORTANTE: cambia este valor por una cadena larga y aleatoria
JWT_SECRET=CAMBIA_ESTA_CLAVE_SEGURA_OFICIOSYA_2026
JWT_EXPIRES=7d

# ── BASE DE DATOS ────────────────────────────────────────────
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://postgres:postgresql://postgres:YubWXZRBdIlJbhGnMIOsMKssBSxoElQm@postgres.railway.internal:5432/railway

# Inicializar tablas automáticamente al arrancar
AUTO_INIT_DB=true

# ── URL DEL FRONTEND ─────────────────────────────────────────
# Usada para los links en los correos (verificación y reset de contraseña)
FRONTEND_URL=https://tu-app.up.railway.app

# ── GOOGLE LOGIN ─────────────────────────────────────────────
# Obtén tu Client ID en: https://console.cloud.google.com/
# Requerido para que el botón "Iniciar sesión con Google" funcione
GOOGLE_CLIENT_ID=492507286056-4lp7kqr55bogg2lrnqofbq1170mtk62a.apps.googleusercontent.com

# ── CORREO (nodemailer) ──────────────────────────────────────
# Si se deja vacío, los correos de verificación y reset se omiten
# Para Gmail, usa una "Contraseña de aplicación" (no tu contraseña normal)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion

# Nombre que aparece en el remitente del correo (opcional)
MAIL_FROM=OficiosYA <tu_correo@gmail.com>

# Servicio de correo: gmail, outlook, yahoo, etc. (por defecto: gmail)
MAIL_SERVICE=gmail

# ── CLOUDINARY (subida de imágenes) ─────────────────────────
# Obtén las credenciales en: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
